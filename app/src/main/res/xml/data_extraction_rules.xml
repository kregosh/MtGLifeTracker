<?xml version="1.0" encoding="utf-8"?>
<!--
    Shared preferences hold the friends list and Firebase's anonymous sign-in, whose uid
    is the player ID. Copying it to another phone would make two devices act as one player.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
