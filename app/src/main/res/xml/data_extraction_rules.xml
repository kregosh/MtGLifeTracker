<?xml version="1.0" encoding="utf-8"?>
<!--
    The player ID in shared preferences identifies this device in every session.
    Copying it to another phone would make two devices act as the same player.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
