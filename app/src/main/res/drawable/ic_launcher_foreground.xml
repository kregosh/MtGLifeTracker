<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon foreground (108dp × 108dp canvas, safe zone 72dp centred).
  Design: a heart-drop life symbol with a lightning bolt crossing through it,
  rendered in silver-white with a pale-blue glow.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- ── soft glow disc behind everything ── -->
    <path
        android:fillColor="#33AACCFF"
        android:pathData="M54,54 m-28,0 a28,28 0 1,0 56,0 a28,28 0 1,0 -56,0"/>

    <!-- ── life-drop / teardrop body ──
         Pointed at top, rounded at bottom — a classic life-total drop.
         Built from a cubic bezier path.  -->
    <path
        android:fillColor="#E8E0FF"
        android:pathData="
          M54,22
          C54,22 32,40 32,56
          C32,67.05 42.06,76 54,76
          C65.94,76 76,67.05 76,56
          C76,40 54,22 54,22 Z"/>

    <!-- ── subtle inner gradient sheen (lighter centre) ── -->
    <path
        android:fillColor="#44FFFFFF"
        android:pathData="
          M54,30
          C54,30 40,44 40,56
          C40,62 46.27,67 54,67
          C61.73,67 68,62 68,56
          C68,44 54,30 54,30 Z"/>

    <!-- ── lightning bolt crossing the drop ── -->
    <!-- Glow layer (wider, semi-transparent) -->
    <path
        android:fillColor="#66BBDDFF"
        android:pathData="M58,26 L46,53 L53,53 L49,78 L63,50 L56,50 Z"/>
    <!-- Main bolt (crisp white) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M57,28 L47,54 L54,54 L50,76 L62,51 L55,51 Z"/>

    <!-- ── tiny specular highlight on the drop ── -->
    <path
        android:fillColor="#55FFFFFF"
        android:pathData="M47,34 C47,34 43,42 43,48 C43,50 44.5,50 45.5,48 C47,44 49,37 49,34 C49,32.5 47,32.5 47,34 Z"/>

</vector>
