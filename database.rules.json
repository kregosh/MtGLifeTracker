{
  "rules": {
    // ── Player identity ──────────────────────────────────────────────────
    // The app identifies players by a UUID kept in device prefs. The first
    // anonymous sign-in to use a UUID claims it here; every other rule checks
    // ownership through this mapping.
    "userAuth": {
      "$userId": {
        ".read":     "auth != null",
        ".write":    "auth != null && newData.val() == auth.uid && (!data.exists() || data.val() == auth.uid)",
        ".validate": "$userId.matches(/^[0-9a-f-]{36}$/)"
      }
    },

    // ── Session code lookup ──────────────────────────────────────────────
    "sessionCodes": {
      "$code": {
        ".read":  "auth != null",
        // Claim a free code, or release one whose session is gone.
        ".write": "auth != null && ((!data.exists() && newData.exists()) || (!newData.exists() && !root.child('sessions').child(data.val()).exists()))",
        ".validate": "$code.matches(/^[A-Z0-9]{6,8}$/) && newData.isString()"
      }
    },

    // ── Per-session data ─────────────────────────────────────────────────
    "sessions": {
      "$sessionId": {
        ".read": "auth != null",
        // Create once. Delete when nobody is left in it, or when it is more
        // than a day old (abandoned sessions are reclaimed on code collisions).
        ".write": "auth != null && ((!data.exists() && newData.exists()) || (data.exists() && !newData.exists() && (!data.child('users').exists() || data.child('createdAt').val() < now - 86400000)))",
        ".validate": "newData.hasChildren(['code', 'createdAt'])",

        "code":      { ".validate": "newData.isString() && newData.val().matches(/^[A-Z0-9]{6,8}$/) && !data.exists()" },
        "createdAt": { ".validate": "newData.isNumber() && newData.val() <= now && !data.exists()" },

        // ── Host and shared game rules ─────────────────────────────────
        // The creator becomes host. Only the host changes the rules or starts
        // a new game; each player then resets their own seat.
        "hostUserId": { ".validate": "newData.isString() && !data.exists() && root.child('userAuth').child(newData.val()).val() == auth.uid" },
        "game": {
          ".write":    "auth != null && root.child('userAuth').child(root.child('sessions').child($sessionId).child('hostUserId').val()).val() == auth.uid",
          ".validate": "newData.isNumber() && (!data.exists() || newData.val() > data.val())"
        },
        "settings": {
          ".write":    "auth != null && root.child('userAuth').child(root.child('sessions').child($sessionId).child('hostUserId').val()).val() == auth.uid",
          ".validate": "newData.hasChildren(['startLife', 'commanderDeathThreshold', 'infectDeathThreshold', 'maxPlayers'])",
          "startLife":               { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 1000" },
          "commanderDeathThreshold": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 100" },
          "infectDeathThreshold":    { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 100" },
          "maxPlayers":              { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 16" },
          "$other": { ".validate": false }
        },

        // ── Per-player state ───────────────────────────────────────────
        "users": {
          "$userId": {
            // The owner writes their own seat. The host may remove anyone, and any
            // player may clear the seat of someone offline (ghosts left behind by a killed app).
            ".write": "auth != null && (root.child('userAuth').child($userId).val() == auth.uid || (!newData.exists() && (data.child('online').val() == false || root.child('userAuth').child(root.child('sessions').child($sessionId).child('hostUserId').val()).val() == auth.uid)))",
            ".validate": "newData.hasChildren(['displayName', 'life'])",

            "displayName": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 64" },
            "life":        { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000" },
            "conceded":    { ".validate": "newData.isBoolean()" },
            "online":      { ".validate": "newData.isBoolean()" },
            "game":        { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "commanderDamage": {
              "$fromUserId": {
                ".validate": "$fromUserId.matches(/^[0-9a-f-]{36}$/) && newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000"
              }
            },
            "customStats": {
              "$stat": {
                ".validate": "$stat.matches(/^[A-Za-z0-9 _'-]{1,32}$/) && newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000"
              }
            },
            "$other": { ".validate": false }
          }
        },

        // ── Custom stat definitions ────────────────────────────────────
        "customStatNames": {
          "$name": {
            ".write": "auth != null",
            ".validate": "$name.matches(/^[A-Za-z0-9 _'-]{1,32}$/) && $name.toLowerCase() != 'life' && $name.toLowerCase() != 'displayname' && $name.toLowerCase() != 'conceded' && $name.toLowerCase() != 'customstats' && (newData.val() == 'NUMERIC' || newData.val() == 'TOGGLE' || newData.val() == 'RING_STAGE')"
          }
        },

        // ── Global stats (day/night, etc.) ─────────────────────────────
        "globalStats": {
          "$stat": {
            ".write": "auth != null",
            ".validate": "$stat.matches(/^[A-Za-z0-9_]{1,32}$/) && newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000"
          }
        },

        // ── Friend requests ────────────────────────────────────────────
        // Only the sender can send; only the recipient can dismiss.
        "friendRequests": {
          "$toUserId": {
            "$fromUserId": {
              ".write": "auth != null && ((newData.exists() && root.child('userAuth').child($fromUserId).val() == auth.uid) || (!newData.exists() && root.child('userAuth').child($toUserId).val() == auth.uid))",
              ".validate": "newData.hasChildren(['displayName']) && newData.child('displayName').isString() && newData.child('displayName').val().length > 0 && newData.child('displayName').val().length <= 64"
            }
          }
        },

        // ── Friend acceptances ─────────────────────────────────────────
        // Only the accepting player can write; only the original sender can dismiss.
        "friendAccepted": {
          "$toUserId": {
            "$fromUserId": {
              ".write": "auth != null && ((newData.exists() && root.child('userAuth').child($fromUserId).val() == auth.uid) || (!newData.exists() && root.child('userAuth').child($toUserId).val() == auth.uid))",
              ".validate": "newData.hasChildren(['displayName']) && newData.child('displayName').isString() && newData.child('displayName').val().length > 0 && newData.child('displayName').val().length <= 64"
            }
          }
        },

        "$other": { ".validate": false }
      }
    },

    // ── Presence (which session a player is in) ──────────────────────────
    "presence": {
      "$userId": {
        ".read":     "auth != null",
        ".write":    "auth != null && root.child('userAuth').child($userId).val() == auth.uid",
        ".validate": "newData.isString()"
      }
    },

    // Deny everything else.
    "$other": { ".read": false, ".write": false }
  }
}
