{
  "rules": {
    // ── Session code lookup ──────────────────────────────────────────────
    "sessionCodes": {
      "$code": {
        ".read":  true,
        ".write": "!data.exists()"
      }
    },

    // ── Per-session data ─────────────────────────────────────────────────
    "sessions": {
      "$sessionId": {
        ".read": true,

        "code":      { ".write": "!data.exists()" },
        "createdAt": { ".write": "!data.exists()" },

        // ── Per-user state ─────────────────────────────────────────────
        // The app identifies itself with a stable UUID stored in device prefs;
        // Firebase anonymous auth is used so writes are authenticated, but
        // the auth.uid differs from the app's userId. Ownership is enforced
        // structurally: each client only knows its own userId and only writes
        // to that path.
        "users": {
          "$userId": {
            ".write": "auth != null",

            "displayName": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 64" },
            "life":        { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "conceded":    { ".validate": "newData.isBoolean()" },
            "customStats": {
              "$stat": {
                ".validate": "$stat != 'life' && $stat != 'displayName' && $stat != 'conceded' && $stat != 'customStats' && newData.isNumber() && newData.val() >= 0"
              }
            }
          }
        },

        // ── Custom stat definitions ────────────────────────────────────
        "customStatNames": {
          "$name": {
            ".write": "auth != null",
            ".validate": "$name != 'life' && $name != 'displayName' && $name != 'conceded' && $name != 'customStats' && (newData.val() == 'NUMERIC' || newData.val() == 'TOGGLE' || newData.val() == 'RING_STAGE')"
          }
        },

        // ── Global stats (day/night, etc.) ─────────────────────────────
        "globalStats": {
          "$stat": {
            ".write": "auth != null",
            ".validate": "newData.isNumber() && newData.val() >= 0"
          }
        },

        // ── Friend requests ────────────────────────────────────────────
        "friendRequests": {
          "$toUserId": {
            "$fromUserId": {
              ".write": "auth != null",
              ".validate": "!newData.exists() || (newData.child('displayName').isString() && newData.child('displayName').val().length > 0)"
            }
          }
        },

        // ── Friend acceptances ─────────────────────────────────────────
        "friendAccepted": {
          "$toUserId": {
            "$fromUserId": {
              ".write": "auth != null",
              ".validate": "!newData.exists() || (newData.child('displayName').isString() && newData.child('displayName').val().length > 0)"
            }
          }
        }
      }
    },

    // ── Presence ─────────────────────────────────────────────────────────
    "presence": {
      "$userId": {
        ".read":     true,
        ".write":    "auth != null",
        ".validate": "newData.isString() || !newData.exists()"
      }
    },

    // Deny everything else.
    "$other": { ".read": false, ".write": false }
  }
}
